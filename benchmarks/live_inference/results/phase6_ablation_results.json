  "core_research_question": "Why does the live QEMU/NVMe path take ~51s when the file-backed optimized path takes ~10s?",
  "bottleneck_isolation_verdict": {
    "primary_bottleneck": "HOST_SIDE_CANDIDATE_KEY_STREAMING",
    "explanation": "Top-k candidate scoring executes on the host CPU, requiring all candidate Key pages (255 blocks/layer * 36 layers * 15 tokens = 8.49 GB) to traverse the storage bus. In file-backed mode, the OS page cache streams 8.49 GB in 2.03s. Over the virtual NVMe bus (bandwidth ~253 MB/s), streaming candidate keys takes 31.71s (62.4% of total decode time), plus 7.64s for prefetch and 2.34s for winning values. Protocol packet serialization and network wait add only 1.05s combined. True in-storage computational filtering (Phase 7) is mathematically required to eliminate this 31.71s bus transfer bottleneck.",
    "nvme_bus_transfer_time_s": 39.35,
    "nvme_protocol_overhead_s": 1.05,
    "compute_time_s": 10.39
  },
